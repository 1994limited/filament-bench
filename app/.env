APP_NAME=FilamentBench
APP_ENV=production
# fixed, so every target has the same Livewire endpoint and the same snapshot checksums (a bench key, not a secret)
APP_KEY=base64:m5M/uLZuPqmHOok0dC/SELjT0V8zd6bhMpcQxwmCuH0=
APP_DEBUG=false
APP_URL=http://bench.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# nothing a request does carries over to the next one through the session or the cache
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array
BCRYPT_ROUNDS=4
